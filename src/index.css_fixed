@tailwind base;
@tailwind components;
@tailwind utilities;

/* BrainX ERP Industrial - Design System */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

@layer base {
  :root {
    /* Industrial ERP Color Scheme */
    --background: 210 20% 98%;
    --foreground: 210 40% 11%;
    
    --card: 0 0% 100%;
    --card-foreground: 210 40% 11%;
    
    --popover: 0 0% 100%;
    --popover-foreground: 210 40% 11%;
    
    /* Primary: Petrol Blue #0F2A44 */
    --primary: 210 65% 16%;
    --primary-foreground: 210 20% 98%;
    
    /* Secondary: Corporate Green #1F8F5F */
    --secondary: 153 64% 34%;
    --secondary-foreground: 0 0% 100%;
    
    --muted: 210 20% 96%;
    --muted-foreground: 210 20% 45%;
    
    --accent: 210 20% 94%;
    --accent-foreground: 210 40% 11%;
    
    /* Destructive: Technical Red */
    --destructive: 0 72% 51%;
    --destructive-foreground: 0 0% 100%;
    
    /* Warning: Amber */
    --warning: 38 92% 50%;
    --warning-foreground: 38 92% 10%;
    
    /* Success: Green */
    --success: 153 64% 34%;
    --success-foreground: 0 0% 100%;
    
    /* Info: Blue */
    --info: 210 65% 45%;
    --info-foreground: 0 0% 100%;
    
    --border: 210 20% 90%;
    --input: 210 20% 90%;
    --ring: 210 65% 16%;
    
    --radius: 0.5rem;
    
    /* Sidebar - Dark Petrol Blue */
    --sidebar-background: 210 65% 16%;
    --sidebar-foreground: 210 20% 95%;
    --sidebar-primary: 153 64% 34%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 210 50% 22%;
    --sidebar-accent-foreground: 210 20% 95%;
    --sidebar-border: 210 50% 22%;
    --sidebar-ring: 153 64% 34%;

    /* Chart colors */
    --chart-1: 210 65% 45%;
    --chart-2: 153 64% 34%;
    --chart-3: 38 92% 50%;
    --chart-4: 0 72% 51%;
    --chart-5: 280 65% 60%;
  }

  .dark {
    --background: 210 40% 8%;
    --foreground: 210 20% 95%;
    
    --card: 210 40% 10%;
    --card-foreground: 210 20% 95%;
    
    --popover: 210 40% 10%;
    --popover-foreground: 210 20% 95%;
    
    --primary: 153 64% 40%;
    --primary-foreground: 0 0% 100%;
    
    --secondary: 210 50% 25%;
    --secondary-foreground: 210 20% 95%;
    
    --muted: 210 40% 15%;
    --muted-foreground: 210 20% 60%;
    
    --accent: 210 40% 18%;
    --accent-foreground: 210 20% 95%;
    
    --destructive: 0 72% 51%;
    --destructive-foreground: 0 0% 100%;
    
    --warning: 38 92% 50%;
    --warning-foreground: 38 92% 10%;
    
    --success: 153 64% 40%;
    --success-foreground: 0 0% 100%;
    
    --info: 210 65% 55%;
    --info-foreground: 0 0% 100%;
    
    --border: 210 40% 18%;
    --input: 210 40% 18%;
    --ring: 153 64% 40%;
    
    --sidebar-background: 210 40% 6%;
    --sidebar-foreground: 210 20% 95%;
    --sidebar-primary: 153 64% 40%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 210 40% 12%;
    --sidebar-accent-foreground: 210 20% 95%;
    --sidebar-border: 210 40% 15%;
    --sidebar-ring: 153 64% 40%;
  }
}
